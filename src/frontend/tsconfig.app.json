/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/app",
    "types": [
      "@angular/localize"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // Angular needs no decorator metadata, and the config classes set their types explicitly.
    // Without it, isolatedModules lets the builder transpile with esbuild instead of tsc.
    "emitDecoratorMetadata": false,
    "isolatedModules": true
  },
  "files": [
    "./main.ts"
  ],
  "include": [
    "./**/*.d.ts"
  ],
  "exclude": []
}
