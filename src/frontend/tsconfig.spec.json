/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "isolatedModules": true,
    "types": [
      "vitest/globals",
      "@angular/localize"
    ]
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "exclude": []
}
