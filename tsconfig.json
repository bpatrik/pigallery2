{
  // Builds the backend, the shared code, the tests and the benchmark next to their sources (npm run build-backend).
  // The IDE and ts-node (IDE test runs) use it too. It is also the base of the Angular CLI's src/frontend/tsconfig.*.json,
  // which set their own module setup, types and files.
  "compileOnSave": true,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    // Node's module system: emits CommonJS (no "type": "module"), and models require(esm) of ESM-only packages
    "module": "nodenext",
    "useDefineForClassFields": false,
    "types": [
      "node",
      "mocha"
    ],
    "lib": [
      "ES2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "ts-node": {
    // load the global typings (e.g. customtypings/ExtendedRequest.d.ts) like tsc does
    "files": true
  },
  "include": [
    "src/backend/**/*.ts",
    "src/common/**/*.ts",
    "test/**/*.ts",
    "benchmark/**/*.ts",
    "gulpfile.ts"
  ],
  "exclude": [
    "cypress.config.ts",
    // See https://github.com/cypress-io/cypress/issues/7552#issuecomment-763498855
    "test/cypress/**/*",
    "extension/**/*",
    "extensions/**/*",
    // test output, e.g. the media files of Routing.spec (.ts and .mts are video formats too)
    "test/tmp/**/*",
    // The Angular CLI builds the frontend with src/frontend/tsconfig.*.json
    "src/frontend/**/*"
  ]
}
