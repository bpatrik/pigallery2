{
  "name": "pigallery2",
  "version": "3.6.0-edge",
  "description": "This is a photo gallery optimised for running low resource servers (especially on raspberry pi)",
  "author": "Patrik J. Braun",
  "homepage": "https://github.com/bpatrik/pigallery2",
  "license": "MIT",
  "main": "./src/backend/index.js",
  "bin": "./src/backend/index.js",
  "scripts": {
    "build": "tsc && gulp build-prod",
    "build-en": "tsc && gulp build-prod --languages=en",
    "create-release": "gulp create-release",
    "build-backend": "tsc",
    "pretest": "tsc",
    "test": "ng test --watch=false --coverage && c8 mocha test --exclude folder-reset.js",
    "test-frontend": "ng test --watch=false",
    "test-backend": "tsc && mocha test --exclude folder-reset.js",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "coverage": "c8 report --reporter=lcov",
    "start": "node ./src/backend/index",
    "run-diagnostics": "node ./src/backend/index --run-diagnostics --Server-Log-level=silly",
    "run-dev": "ng build  --configuration=dev",
    "build-stats": "ng build --configuration production,stats",
    "analyze": "npm run build-stats && echo Load dist/en/stats.json into https://esbuild.github.io/analyze/",
    "merge-new-translation": "gulp merge-new-translation",
    "generate-man": "gulp generate-man",
    "lint": "ng lint",
    "start-e2e-server": "node ./test/folder-reset test/e2e && node ./src/backend/index --config-path=test/e2e/config.json --Database-dbFolder=test/e2e --Server-port=8080 --Users.suppressDefUserWarn=true",
    "start-docs-e2e-server": "npm run start-e2e-server -- \"--Media-folder=demo/images2/docs/puerto rico\" --Media-tempFolder=demo/tmp/docs --Extensions-enabled=false",
    "build-extension-interface": "tsc -p extension/ext-interface.tsconfig.json && tsc -p extension/ext-enums.tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpatrik/PiGallery2.git"
  },
  "bugs": {
    "url": "https://github.com/bpatrik/PiGallery2/issues"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "archiver": "8.0.0",
    "bcrypt": "6.0.0",
    "better-sqlite3": "12.11.1",
    "cookie-parser": "1.4.7",
    "cookie-session": "2.1.1",
    "ejs": "7.0.2",
    "exif-reader": "2.0.3",
    "exifr": "7.1.3",
    "express": "5.3.0",
    "image-size": "2.1.0",
    "locale": "0.1.0",
    "multer": "2.5.0",
    "node-geocoder": "4.4.1",
    "nodemailer": "10.3.1",
    "openid-client": "6.8.9",
    "reflect-metadata": "0.2.2",
    "sharp": "0.34.2",
    "tslib": "2.9.1",
    "typeconfig": "2.5.0",
    "typeorm": "1.1.2",
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@angular/localize": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@bluehalo/ngx-leaflet": "22.0.0",
    "@bluehalo/ngx-leaflet-markercluster": "22.0.0",
    "@eslint/js": "10.0.1",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/ionicons": "36.1.0",
    "@ngx-loading-bar/core": "7.0.1",
    "@playwright/test": "1.65.0",
    "@types/archiver": "8.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/chai": "5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/cookie-parser": "1.4.10",
    "@types/cookie-session": "2.0.49",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/gulp": "4.0.18",
    "@types/gulp-zip": "4.0.4",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/mocha": "10.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/node-geocoder": "4.2.6",
    "@types/xml2js": "0.4.14",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "bootstrap": "5.3.8",
    "c8": "12.0.0",
    "chai": "6.3.0",
    "chai-as-promised": "8.0.2",
    "chai-http": "5.2.1",
    "deep-equal-in-any-order": "2.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-chai-friendly": "1.2.1",
    "gulp": "5.0.1",
    "gulp-json-editor": "2.6.0",
    "gulp-zip": "6.1.0",
    "jsdom": "31.0.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "mocha": "12.0.3",
    "ngx-bootstrap": "22.0.0",
    "ngx-markdown": "22.1.1",
    "rxjs": "7.8.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "xlf-google-translate": "2.1.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "mysql2": "3.24.6"
  },
  "engines": {
    "node": "^24.15.0 || ^26.12.0"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "bcrypt": true,
    "sharp": true,
    "ffmpeg-static": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "@parcel/watcher": true,
    "es5-ext": false
  }
}
